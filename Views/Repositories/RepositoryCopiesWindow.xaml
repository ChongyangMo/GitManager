<Window x:Class="GitManager.Views.Repositories.RepositoryCopiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1040" Height="720" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterOwner" Style="{StaticResource WorkspaceWindow}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="StateText" Text="正在比较仓库" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border x:Name="AnalysisPanel" Style="{StaticResource Card}" Margin="0,0,12,16">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Button x:Name="AnalyzeButton" Content="重新分析" DockPanel.Dock="Right" Click="AnalyzeClicked"
                                    Style="{StaticResource WorkspaceButton}" Margin="12,0,0,0"/>
                            <TextBlock x:Name="AnalysisState" Text="正在读取仓库" Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <FlowDocumentScrollViewer x:Name="AnalysisDocument" Visibility="Collapsed" Margin="0,12,0,0"
                                                  MaxHeight="300" MinHeight="100" IsToolBarVisible="False"
                                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                    </StackPanel>
                </Border>
                <ItemsControl x:Name="CopiesList" IsEnabled="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="460" Margin="0,0,12,12" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,12"/>
                                    <TextBlock Text="位置" Style="{StaticResource Hint}"/>
                                    <TextBlock Text="{Binding Path}" TextWrapping="Wrap" Margin="0,3,0,10"/>
                                    <TextBlock Text="远程" Style="{StaticResource Hint}"/>
                                    <TextBlock Text="{Binding Remote}" TextWrapping="Wrap" Margin="0,3,0,10"/>
                                    <TextBlock Text="分支" Style="{StaticResource Hint}"/>
                                    <TextBlock Text="{Binding Branch}" Margin="0,3,0,10"/>
                                    <TextBlock Text="最近提交" Style="{StaticResource Hint}"/>
                                    <TextBlock Text="{Binding Commit}" TextWrapping="Wrap" Margin="0,3,0,10"/>
                                    <TextBlock Text="未提交改动" Style="{StaticResource Hint}"/>
                                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,3,0,10">
                                        <TextBlock Text="{Binding Changes}" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="打开目录" Click="OpenFolderClicked" Margin="0,0,8,8" MinHeight="34"/>
                                        <Button Content="移除记录" Click="RemoveClicked" Margin="0,0,8,8" MinHeight="34"/>
                                        <Button Content="删除本地文件" Style="{StaticResource DangerButton}" IsEnabled="{Binding CanDeleteLocal}" Click="DeleteClicked" Margin="0,0,0,8" MinHeight="34"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="FileState" FontWeight="SemiBold" Margin="0,8,0,10" ToolTip="比较 Git 跟踪文件与未忽略的未跟踪文件；不包含 .git 和被忽略的构建产物。"/>
                <ListBox x:Name="DifferencesList" Style="{StaticResource WorkspaceList}" MaxHeight="300" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="480"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Path}" TextWrapping="Wrap" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Difference}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Button x:Name="LineEndingToggle" Visibility="Collapsed" HorizontalAlignment="Left" Style="{StaticResource WorkspaceButton}"
                        Margin="0,12,0,8" Click="LineEndingToggleClicked" ToolTip="同一内容在不同 core.autocrlf 设置下检出，只是 CRLF 与 LF 不同，不影响提交内容。"/>
                <ListBox x:Name="LineEndingList" Visibility="Collapsed" Style="{StaticResource WorkspaceList}" MaxHeight="240" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="480"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Path}" TextWrapping="Wrap" Margin="0,0,16,0" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Difference}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="2" Content="关闭" IsCancel="True" HorizontalAlignment="Right" Style="{StaticResource WorkspaceButton}" Margin="0,16,0,0"/>
    </Grid>
</Window>
