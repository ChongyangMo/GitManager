<UserControl x:Class="GitManager.Views.Versions.VersionStatusBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="18,10" IsEnabled="{Binding CanOperate}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="{Binding LocalVersionLabel}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" ToolTip="{Binding LocalVersionDetail}" />
            <DockPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock DockPanel.Dock="Left" Text="{Binding RemoteSource}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding RemoteVersionHash}" VerticalAlignment="Center" FontFamily="Consolas" Margin="10,0,0,0" ToolTip="{Binding RemoteVersionDetail}" />
                <ComboBox ItemsSource="{Binding RemoteBranches}" SelectedItem="{Binding SelectedRemoteBranch}" DisplayMemberPath="Display" MinHeight="30" MaxWidth="200" HorizontalAlignment="Left" MinWidth="120" SelectionChanged="RemoteBranchChanged" ToolTip="远程分支" />
            </DockPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="对比" Style="{StaticResource WorkspaceButton}" Click="CompareClicked" Margin="0,0,8,0" />
                <Button Content="合并远程" Style="{StaticResource WorkspaceButton}" Click="MergeClicked" Margin="0,0,8,0" IsEnabled="{Binding CanMergeRemote}" Visibility="{Binding CanMergeRemote, Converter={StaticResource BoolVisibility}}" />
                <Button Content="同步" Style="{StaticResource PrimaryButton}" MinHeight="34" Click="SyncClicked" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{Binding SyncStateText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,7,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding FetchStateText}" ToolTip="{Binding FetchError}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</UserControl>
