<UserControl x:Class="GitManager.Views.Versions.ConflictActions" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:GitManager.Views" Visibility="{Binding IsMerging, Converter={StaticResource BoolVisibility}}">
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10">
        <StackPanel>
            <WrapPanel IsEnabled="{Binding CanResolveSelected}" views:BusyFeedback.DeferDisabledLook="False">
                <Button Content="采用本地" Tag="ours" Click="ResolveClicked" Style="{StaticResource QuietButton}" />
                <Button Content="采用远程" Tag="theirs" Click="ResolveClicked" Style="{StaticResource QuietButton}" />
                <Button Content="编辑文件" Click="EditClicked" Style="{StaticResource QuietButton}" />
                <Button Content="标记已解决" Tag="edited" Click="ResolveClicked" Style="{StaticResource QuietButton}" />
            </WrapPanel>
            <Button Content="取消合并" Click="AbortClicked" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" />
        </StackPanel>
    </Border>
</UserControl>
