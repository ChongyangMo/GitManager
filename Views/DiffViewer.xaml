<UserControl x:Class="GitManager.Views.DiffViewer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:GitManager.Views" x:Name="Viewer">
    <Grid Background="{DynamicResource CardBrush}">
        <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid x:Name="HeaderGrid">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Padding="16,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"><TextBlock Text="{Binding Comparison.BeforeLabel, ElementName=Viewer}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" /></Border>
                <Border Grid.Column="1" Padding="16,0,6,0"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="上一处" Style="{StaticResource QuietButton}" MinWidth="52" Padding="6,0" Click="PreviousChange" /><Button Content="下一处" Style="{StaticResource QuietButton}" MinWidth="52" Padding="6,0" Click="NextChange" /></StackPanel><TextBlock Text="{Binding Comparison.AfterLabel, ElementName=Viewer}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" /></DockPanel></Border>
            </Grid>
        </Border>
        <!-- 左右两栏在同一行模板内，纵向滚动天然同步；横向由各自的滚动条统一平移整栏文本。 -->
        <ListBox x:Name="DiffList" Grid.Row="1" ItemsSource="{Binding Rows, ElementName=Viewer}" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontFamily="Cascadia Mono,Consolas" FontSize="12" ItemContainerStyle="{StaticResource DiffItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.ScrollChanged="DiffScrolled" PreviewMouseWheel="DiffMouseWheel" ContextMenuOpening="DiffMenuOpening" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling" SelectionMode="Extended">
            <ListBox.ContextMenu><ContextMenu><MenuItem x:Name="CopyBeforeItem" Header="复制原文件" Click="CopyBefore" /><MenuItem x:Name="CopyAfterItem" Header="复制当前文件" Click="CopyAfter" /></ContextMenu></ListBox.ContextMenu>
            <ListBox.ItemTemplate><DataTemplate>
                <Grid MinHeight="21">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <DockPanel x:Name="BeforeCell" Background="Transparent">
                        <TextBlock Text="{Binding BeforeNumber}" Width="46" Padding="0,2,10,2" TextAlignment="Right" Foreground="{DynamicResource MutedBrush}" />
                        <views:DiffLinePanel><TextBlock Text="{Binding Before}" Padding="6,2,16,2" RenderTransform="{Binding BeforeShift, RelativeSource={RelativeSource AncestorType=views:DiffViewer}}" /></views:DiffLinePanel>
                    </DockPanel>
                    <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />
                    <DockPanel x:Name="AfterCell" Grid.Column="2" Background="Transparent">
                        <TextBlock Text="{Binding AfterNumber}" Width="46" Padding="0,2,10,2" TextAlignment="Right" Foreground="{DynamicResource MutedBrush}" />
                        <views:DiffLinePanel><TextBlock Text="{Binding After}" Padding="6,2,16,2" RenderTransform="{Binding AfterShift, RelativeSource={RelativeSource AncestorType=views:DiffViewer}}" /></views:DiffLinePanel>
                    </DockPanel>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Removed}" Value="True"><Setter TargetName="BeforeCell" Property="Background" Value="{DynamicResource DangerHoverBrush}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Added}" Value="True"><Setter TargetName="AfterCell" Property="Background" Value="{DynamicResource SelectBrush}" /></DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Grid x:Name="ScrollGrid" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <ScrollBar x:Name="BeforeScroll" Orientation="Horizontal" Margin="46,0,0,0" ValueChanged="BeforeScrolled" />
            <ScrollBar x:Name="AfterScroll" Grid.Column="2" Orientation="Horizontal" Margin="46,0,0,0" ValueChanged="AfterScrolled" />
        </Grid>
        <TextBlock Grid.Row="1" Text="选择文件查看差异" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Comparison, ElementName=Viewer}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <TextBlock Grid.Row="3" Text="{Binding Comparison.Notice, ElementName=Viewer}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="16,8" />
    </Grid>
</UserControl>
