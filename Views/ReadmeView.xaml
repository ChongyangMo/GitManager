<UserControl x:Class="GitManager.Views.ReadmeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Viewer">
    <Grid Background="{DynamicResource CardBrush}">
        <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Padding="16,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><TextBlock Text="{Binding Document.FileName, ElementName=Viewer, FallbackValue=README}" ToolTip="{Binding Document.Path, ElementName=Viewer}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" /></Border>
        <FlowDocumentScrollViewer x:Name="DocumentViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsToolBarVisible="False" Focusable="False" />
        <TextBlock x:Name="EmptyText" Grid.Row="1" Text="这个仓库根目录没有 README 文件" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" />
    </Grid>
</UserControl>
