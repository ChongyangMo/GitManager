<Window x:Class="GitManager.Views.ServiceCloud.ServiceCloudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="服务云" Width="620" Height="640" MinWidth="560" MinHeight="580" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Style="{StaticResource WorkspaceWindow}">
    <Border Padding="22" Background="{DynamicResource PageBrush}"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel x:Name="LoginFields">
            <TextBlock Text="服务地址" Margin="0,0,0,6" /><TextBox x:Name="ServerBox" MinHeight="34" Margin="0,0,0,12" />
            <TextBlock Text="代理" Margin="0,0,0,6" /><TextBox x:Name="ProxyBox" MinHeight="34" Margin="0,0,0,12" />
            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="账号" Margin="0,0,0,6" /><TextBox x:Name="UsernameBox" MinHeight="34" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="密码" Margin="0,0,0,6" /><PasswordBox x:Name="PasswordBox" MinHeight="34" VerticalContentAlignment="Center" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" Padding="8,4" /></StackPanel>
            </Grid>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,12"><Button x:Name="LoginButton" Content="登录" Style="{StaticResource PrimaryButton}" Click="LoginClicked" HorizontalAlignment="Left" /><Button x:Name="RefreshButton" Content="刷新" Style="{StaticResource QuietButton}" Click="RefreshClicked" HorizontalAlignment="Right" IsEnabled="False" /></DockPanel>
        <ListBox x:Name="RepositoryList" Grid.Row="2" DisplayMemberPath="Name" ItemContainerStyle="{StaticResource WorkspaceRow}" SelectionChanged="RepositoryChanged" IsEnabled="False" />
        <DockPanel x:Name="CreatePanel" Grid.Row="3" Margin="0,12,0,0" IsEnabled="False"><Button x:Name="CreateButton" DockPanel.Dock="Right" Content="新建并同步" Style="{StaticResource WorkspaceButton}" Click="CreateClicked" Margin="10,0,0,0" /><TextBox x:Name="NewNameBox" MinHeight="34" VerticalContentAlignment="Center" ToolTip="新仓库名称，可使用目录/仓库名" /></DockPanel>
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="关闭" IsCancel="True" Style="{StaticResource WorkspaceButton}" Margin="0,0,8,0" /><Button x:Name="CloneButton" Content="克隆" Style="{StaticResource WorkspaceButton}" Click="CloneClicked" IsEnabled="False" Margin="0,0,8,0" /><Button x:Name="ConnectButton" Content="连接并同步" Style="{StaticResource PrimaryButton}" Click="ConnectClicked" IsEnabled="False" /></StackPanel>
        </StackPanel>
    </Grid></Border>
</Window>
