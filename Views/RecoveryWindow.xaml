<Window x:Class="GitManager.Views.RecoveryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="恢复点" Width="620" Height="400" MinWidth="480" MinHeight="280" WindowStartupLocation="CenterOwner" Style="{StaticResource WorkspaceWindow}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="取消" Style="{StaticResource WorkspaceButton}" IsCancel="True" Margin="0,0,8,0" /><Button Content="取回修改" Style="{StaticResource PrimaryButton}" MinHeight="34" Click="ApplyClicked" /></StackPanel>
        <Grid><ListBox x:Name="PointsList" Style="{StaticResource WorkspaceList}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" /><TextBlock Text="{Binding Reference}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="没有保存的恢复点" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ElementName=PointsList, Path=Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    </DockPanel>
</Window>
