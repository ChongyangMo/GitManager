<Window x:Class="GitManager.Views.FormWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Style="{StaticResource WorkspaceWindow}">
    <StackPanel Margin="22">
        <ItemsControl ItemsSource="{Binding Fields}">
            <ItemsControl.ItemTemplate><DataTemplate>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="{Binding Label}" Margin="0,0,0,8" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="浏览" Margin="8,0,0,0" Style="{StaticResource WorkspaceButton}" Visibility="{Binding HasPicker, Converter={StaticResource BoolVisibility}}" Click="BrowseClicked" />
                        <Grid>
                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" VerticalContentAlignment="Center">
                                <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsSecret}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBox.Style>
                            </TextBox>
                            <PasswordBox PasswordChanged="SecretChanged" MinHeight="34" VerticalContentAlignment="Center" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" Padding="8,4">
                                <PasswordBox.Style><Style TargetType="PasswordBox"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsSecret}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></PasswordBox.Style>
                            </PasswordBox>
                        </Grid>
                    </DockPanel>
                </StackPanel>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <CheckBox x:Name="OptionBox" Visibility="Collapsed" Margin="0,0,0,16" />
        <StackPanel x:Name="ThemePanel" Visibility="Collapsed" Margin="0,0,0,16"><TextBlock Text="主题" Margin="0,0,0,8" /><ComboBox x:Name="ThemeBox" ItemsSource="{Binding Themes}" DisplayMemberPath="Label" SelectedValuePath="Value" MinHeight="34" /></StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
        <DockPanel><StackPanel x:Name="ActionPanel" DockPanel.Dock="Left" Orientation="Horizontal" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Style="{StaticResource WorkspaceButton}" Margin="0,0,8,0" /><Button x:Name="SubmitButton" Content="确定" IsDefault="True" Style="{StaticResource PrimaryButton}" MinHeight="34" Click="SaveClicked" /></StackPanel></DockPanel>
    </StackPanel>
</Window>
