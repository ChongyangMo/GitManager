<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:layout="clr-namespace:GitManager.Views.Layout" xmlns:motion="clr-namespace:GitManager.Views.Motion">
    <Style TargetType="layout:CollapsiblePane">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="layout:CollapsiblePane">
            <DockPanel Background="{DynamicResource CardBrush}">
                <Button x:Name="PART_Toggle" DockPanel.Dock="Top" Style="{DynamicResource QuietButton}" MinHeight="28" MinWidth="28" Width="28" Padding="4,0" HorizontalAlignment="Right"
                        ToolTip="{Binding Label, RelativeSource={RelativeSource TemplatedParent}, StringFormat=折叠{0}}"
                        AutomationProperties.Name="{Binding Label, RelativeSource={RelativeSource TemplatedParent}, StringFormat=折叠{0}}">
                    <StackPanel x:Name="ToggleContent" Orientation="Horizontal">
                        <TextBlock x:Name="Arrow" Text="⌃" FontSize="17" VerticalAlignment="Center" />
                        <TextBlock x:Name="CollapsedLabel" Text="{TemplateBinding Label}" Visibility="Collapsed" VerticalAlignment="Center" Margin="4,0" />
                    </StackPanel>
                </Button>
                <ContentPresenter x:Name="Body" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" motion:InteractionMotion.IsActive="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
            </DockPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="Arrow" Property="Text" Value="‹" /></Trigger>
                <Trigger Property="IsExpanded" Value="False">
                    <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="CollapsedLabel" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Arrow" Property="Text" Value="⌄" />
                    <Setter TargetName="PART_Toggle" Property="HorizontalAlignment" Value="Stretch" />
                    <Setter TargetName="PART_Toggle" Property="Width" Value="Auto" />
                    <Setter TargetName="PART_Toggle" Property="ToolTip" Value="{Binding Label, RelativeSource={RelativeSource TemplatedParent}, StringFormat=展开{0}}" />
                    <Setter TargetName="PART_Toggle" Property="AutomationProperties.Name" Value="{Binding Label, RelativeSource={RelativeSource TemplatedParent}, StringFormat=展开{0}}" />
                </Trigger>
                <MultiTrigger><MultiTrigger.Conditions><Condition Property="Orientation" Value="Horizontal" /><Condition Property="IsExpanded" Value="False" /></MultiTrigger.Conditions>
                    <Setter TargetName="PART_Toggle" Property="VerticalAlignment" Value="Top" />
                    <Setter TargetName="ToggleContent" Property="Orientation" Value="Vertical" />
                    <Setter TargetName="Arrow" Property="Text" Value="›" />
                    <Setter TargetName="CollapsedLabel" Property="Width" Value="14" />
                    <Setter TargetName="CollapsedLabel" Property="TextWrapping" Value="Wrap" />
                    <Setter TargetName="CollapsedLabel" Property="Margin" Value="0,4" />
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
