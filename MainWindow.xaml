<Window x:Class="GitManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:GitManager.Views" xmlns:versions="clr-namespace:GitManager.Views.Versions" xmlns:vm="clr-namespace:GitManager.ViewModels" xmlns:layout="clr-namespace:GitManager.Views.Layout" Title="GitManager" Width="1200" Height="760" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterScreen" Style="{StaticResource WorkspaceWindow}" AllowDrop="True" Drop="RepositoryDropped" KeyDown="WindowKeyDown">
    <Grid views:BusyFeedback.DeferDisabledLook="{Binding IsBusyFeedbackDeferred}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="32" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="214" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <layout:CollapsiblePane SettingsKey="Repositories" Label="仓库" Orientation="Horizontal">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel IsEnabled="{Binding IsIdle}">
                    <StackPanel DockPanel.Dock="Top" Margin="16,22,16,18">
                        <DockPanel Margin="4,0,0,22"><Image Source="/GitManager;component/Assets/gitmanager.png" Width="28" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" /><TextBlock Text="GitManager" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
                        <StackPanel><Button Content="添加仓库" Style="{StaticResource WorkspaceButton}" HorizontalAlignment="Stretch" Click="AddMenuClicked"><Button.ContextMenu><ContextMenu><MenuItem Header="添加本地仓库" Click="AddRepositoryClicked" /><MenuItem Header="新建仓库" Click="CreateRepositoryClicked" /><MenuItem Header="克隆仓库" Click="CloneRepositoryClicked" /></ContextMenu></Button.ContextMenu></Button><Button Content="服务云" Style="{StaticResource WorkspaceButton}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="ServiceCloudClicked" /></StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="12,12,12,16"><Button Content="设置" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" Click="SettingsClicked" /></StackPanel>
                    <ListBox x:Name="RepositoryList" ItemsSource="{Binding Repositories}" SelectedItem="{Binding Repository, Mode=OneWay}" Style="{StaticResource WorkspaceList}" SelectionChanged="RepositoryChanged">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource WorkspaceRow}">
                            <Setter Property="ContextMenu"><Setter.Value><ContextMenu/></Setter.Value></Setter>
                            <EventSetter Event="ContextMenuOpening" Handler="RepositoryContextMenuOpening"/>
                        </Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <DockPanel ToolTip="{Binding ConflictHint}">
                                <Ellipse x:Name="PendingPushDot" DockPanel.Dock="Right" Width="8" Height="8" Margin="8,0,2,0" VerticalAlignment="Center"
                                         Fill="{DynamicResource DangerBrush}" Visibility="{Binding HasPendingPush, Converter={StaticResource BoolVisibility}}"
                                         ToolTip="{Binding PendingPushHint}" AutomationProperties.Name="{Binding PendingPushHint}" />
                                <Button x:Name="ConflictButton" DockPanel.Dock="Right" Content="同名" Tag="{Binding}" Visibility="Collapsed"
                                        Style="{StaticResource QuietButton}" Foreground="{DynamicResource WarningBrush}" MinWidth="34" MinHeight="24" Padding="4,0"
                                        Margin="5,0,0,0" Click="CompareRepositoryCopiesClicked" ToolTip="比较同名仓库"/>
                                <TextBlock x:Name="RepositoryName" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataTemplate.Triggers><DataTrigger Binding="{Binding HasNameConflict}" Value="True">
                                <Setter TargetName="RepositoryName" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                <Setter TargetName="ConflictButton" Property="Visibility" Value="Visible"/>
                            </DataTrigger></DataTemplate.Triggers>
                        </DataTemplate></ListBox.ItemTemplate>
                        <ListBox.GroupStyle><GroupStyle AlternationCount="1000"><GroupStyle.ContainerStyle><Style TargetType="GroupItem">
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem">
                                <StackPanel>
                                    <Border x:Name="GroupLine" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="10,8,10,0" />
                                    <TextBlock x:Name="GroupName" Text="{Binding Name}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="10,8,10,2" />
                                    <ItemsPresenter />
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="0"><Setter TargetName="GroupLine" Property="Visibility" Value="Collapsed" /><Setter TargetName="GroupName" Property="Margin" Value="10,0,10,2" /></Trigger>
                                    <DataTrigger Binding="{Binding Name}" Value=""><Setter TargetName="GroupLine" Property="Visibility" Value="Collapsed" /><Setter TargetName="GroupName" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Setter.Value></Setter>
                        </Style></GroupStyle.ContainerStyle></GroupStyle></ListBox.GroupStyle>
                    </ListBox>
                </DockPanel>
            </Border>
            </layout:CollapsiblePane>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource CardBrush}">
                    <DockPanel Margin="18,0" IsEnabled="{Binding CanOperate}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="远程" Style="{StaticResource QuietButton}" ToolTip="{Binding Remote}" Click="RemoteClicked" Margin="0,0,8,0" /><Button Content="获取" Style="{StaticResource WorkspaceButton}" Click="FetchClicked" Margin="0,0,8,0" /><Button Content="拉取" Style="{StaticResource WorkspaceButton}" Click="PullClicked" Margin="0,0,8,0" /><Button Content="推送" Style="{StaticResource PrimaryButton}" MinHeight="34" Click="PushClicked" /></StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ComboBox x:Name="BranchBox" ItemsSource="{Binding Branches}" SelectedItem="{Binding Branch}" Width="160" MinHeight="32" Margin="0,0,8,0" SelectionChanged="BranchChanged" ToolTip="当前分支" /><Button Content="新分支" Style="{StaticResource QuietButton}" Click="NewBranchClicked" Margin="0,0,6,0" /><Button Content="刷新" Style="{StaticResource QuietButton}" Click="RefreshClicked" ToolTip="F5" /><Button Content="恢复点" Style="{StaticResource QuietButton}" Click="RecoveryClicked" /></StackPanel>
                    </DockPanel>
                </Border>
                <versions:VersionStatusBar Grid.Row="1"><versions:VersionStatusBar.Style><Style TargetType="versions:VersionStatusBar"><Style.Triggers><DataTrigger Binding="{Binding IsWorkspaceLoading}" Value="True"><Setter Property="Visibility" Value="Hidden" /></DataTrigger></Style.Triggers></Style></versions:VersionStatusBar.Style></versions:VersionStatusBar>
                <Grid Grid.Row="2" IsEnabled="{Binding IsIdle}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="360" MinWidth="285" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" MinWidth="360" /></Grid.ColumnDefinitions>
                    <layout:CollapsiblePane SettingsKey="Workspace" Label="记录" Orientation="Horizontal">
                    <TabControl x:Name="WorkspaceTabs" SelectedIndex="{Binding ActiveTab}" SelectionChanged="TabChanged">
                        <TabItem Header="说明">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" TextElement.Foreground="{DynamicResource TextBrush}">
                                <StackPanel Margin="18,16,18,18">
                                    <StackPanel.Resources>
                                        <Style x:Key="InfoLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,16,0,5" /></Style>
                                        <Style x:Key="InfoValue" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" /></Style>
                                    </StackPanel.Resources>
                                    <TextBlock Text="{Binding Repository.Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="位置" Style="{StaticResource InfoLabel}" /><TextBlock Text="{Binding Repository.Path}" Style="{StaticResource InfoValue}" />
                                    <StackPanel>
                                    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsWorkspaceLoading}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <TextBlock Text="当前分支" Style="{StaticResource InfoLabel}" /><TextBlock Text="{Binding Branch}" Style="{StaticResource InfoValue}" />
                                    <TextBlock Text="远程地址" Style="{StaticResource InfoLabel}" />
                                    <ItemsControl x:Name="RemoteAddressList" ItemsSource="{Binding RemoteAddresses}" Visibility="{Binding HasRemoteAddresses, Converter={StaticResource BoolVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="RemoteRow" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                                                    <StackPanel><TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,2" /><TextBlock Text="{Binding Url}" Style="{StaticResource InfoValue}" /></StackPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}"><Setter TargetName="RemoteRow" Property="BorderThickness" Value="0" /><Setter TargetName="RemoteRow" Property="Margin" Value="0" /><Setter TargetName="RemoteRow" Property="Padding" Value="0" /></DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="未设置">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasRemoteAddresses}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Visibility="{Binding IsGitHubRemote, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock Text="GitHub 可见性" Style="{StaticResource InfoLabel}" />
                                        <DockPanel><Button x:Name="GitHubVisibilityButton" DockPanel.Dock="Right" Content="{Binding GitHubVisibilityAction}" Style="{StaticResource QuietButton}" Padding="8,0" MinHeight="26" Margin="8,0,0,0" VerticalAlignment="Center" Click="GitHubVisibilityClicked" Visibility="{Binding CanChangeGitHubVisibility, Converter={StaticResource BoolVisibility}}" /><TextBlock Text="{Binding GitHubVisibilityText}" Style="{StaticResource InfoValue}" VerticalAlignment="Center" /></DockPanel>
                                    </StackPanel>
                                    <TextBlock Text="自动上传" Style="{StaticResource InfoLabel}" />
                                    <CheckBox Content="{Binding AutoUploadDescription}" IsChecked="{Binding IsAutoUploadEnabled}" />
                                    <TextBlock Text="{Binding AutoUploadStatus}" Style="{StaticResource InfoValue}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                                    <TextBlock Text="最近提交" Style="{StaticResource InfoLabel}" /><TextBlock Text="{Binding History[0].Subject, FallbackValue=暂无提交}" Style="{StaticResource InfoValue}" />
                                    <TextBlock Text="说明文件" Style="{StaticResource InfoLabel}" /><TextBlock Text="{Binding Readme.FileName, FallbackValue=无}" Style="{StaticResource InfoValue}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button Content="打开文件夹" Style="{StaticResource WorkspaceButton}" Margin="0,0,8,0" Click="OpenRepositoryFolderClicked" /><Button Content="打开说明文件" Style="{StaticResource WorkspaceButton}" Click="OpenReadmeClicked" IsEnabled="{Binding HasReadme}" views:BusyFeedback.DeferDisabledLook="False" /></StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{Binding ChangesTitle}">
                            <DockPanel>
                                <versions:ConflictActions DockPanel.Dock="Top" />
                                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16">
                                    <StackPanel><DockPanel Margin="0,0,0,8"><Button x:Name="GenerateCommitMessageButton" IsEnabled="{Binding CanOperate}" DockPanel.Dock="Right" Content="{Binding GenerateCommitMessageLabel}" Style="{StaticResource QuietButton}" Padding="8,0" MinHeight="26" Click="GenerateSummaryClicked" /><TextBlock Text="提交说明" VerticalAlignment="Center" /></DockPanel><TextBox x:Name="CommitInput" Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" Height="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" /><DockPanel Margin="0,12,0,0"><Button x:Name="CommitButton" IsEnabled="{Binding CanOperate}" DockPanel.Dock="Right" Content="{Binding CommitButtonLabel}" Style="{StaticResource PrimaryButton}" MinHeight="34" Click="CommitClicked" /><StackPanel Orientation="Horizontal"><Button Content="全选" Style="{StaticResource QuietButton}" MinWidth="46" Padding="5,0" Click="SelectAllClicked" /><Button Content="取消" Style="{StaticResource QuietButton}" MinWidth="46" Padding="5,0" Click="SelectNoneClicked" /></StackPanel></DockPanel></StackPanel>
                                </Border>
                                <Grid><ListBox x:Name="ChangesList" ItemsSource="{Binding Changes}" SelectedItem="{Binding SelectedChange}" Style="{StaticResource WorkspaceList}" SelectionChanged="ChangeSelected"><ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Path}"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding State}" TextAlignment="Right" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="没有未提交改动" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Changes.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="{Binding HistoryTitle}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="3*" /><RowDefinition Height="5" /><RowDefinition Height="2*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <layout:CollapsiblePane SettingsKey="LocalHistory" Label="提交记录">
                                <ListBox x:Name="HistoryList" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedCommit}" Style="{StaticResource WorkspaceList}" ItemTemplate="{StaticResource CommitRowTemplate}" SelectionChanged="CommitSelected" />
                                </layout:CollapsiblePane>
                                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" />
                                <layout:CollapsiblePane Grid.Row="2" SettingsKey="LocalFiles" Label="文件">
                                <ListBox x:Name="HistoryFilesList" ItemsSource="{Binding HistoryFiles}" SelectedItem="{Binding SelectedHistoryFile}" SelectionChanged="HistoryFileSelected"><ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource WorkspaceList}"><Style.Triggers><DataTrigger Binding="{Binding IsHistoryLoading}" Value="True"><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.55" BeginTime="0:0:0.25" Duration="0:0:0.12" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions><DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" /></Storyboard></BeginStoryboard></DataTrigger.ExitActions></DataTrigger></Style.Triggers></Style></ListBox.Style><ListBox.ItemTemplate><DataTemplate><DockPanel ToolTip="{Binding Path}"><TextBlock DockPanel.Dock="Right" Text="{Binding State}" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" /><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" /></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                                </layout:CollapsiblePane>
                                <Border Grid.Row="3" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"><StackPanel Orientation="Horizontal"><Button Content="恢复此文件" Style="{StaticResource WorkspaceButton}" Margin="0,0,8,0" Click="RestoreFileClicked" /><Button Content="恢复此版本" Style="{StaticResource WorkspaceButton}" Click="RestoreVersionClicked" /></StackPanel></Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="{Binding RemoteTitle}"><versions:RemoteHistoryView /></TabItem>
                        <TabItem Header="对比"><versions:VersionComparisonView /></TabItem>
                    </TabControl>
                    </layout:CollapsiblePane>
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" />
                    <layout:CollapsiblePane Grid.Column="2" SettingsKey="Preview" Label="差异" Orientation="Horizontal">
                    <Grid>
                    <views:DiffViewer Rows="{Binding DiffRows}" Comparison="{Binding Comparison}"><views:DiffViewer.Style><Style TargetType="views:DiffViewer"><Style.Triggers><DataTrigger Binding="{Binding IsHistoryLoading}" Value="True"><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.55" BeginTime="0:0:0.25" Duration="0:0:0.12" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions><DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" /></Storyboard></BeginStoryboard></DataTrigger.ExitActions></DataTrigger><DataTrigger Binding="{Binding ActiveTab}" Value="{x:Static vm:MainViewModel.ReadmeTab}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></views:DiffViewer.Style></views:DiffViewer>
                    <views:ReadmeView Document="{Binding Readme}" IsLoading="{Binding IsWorkspaceLoading}"><views:ReadmeView.Style><Style TargetType="views:ReadmeView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ActiveTab}" Value="{x:Static vm:MainViewModel.ReadmeTab}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></views:ReadmeView.Style></views:ReadmeView>
                    </Grid>
                    </layout:CollapsiblePane>
                </Grid>
                <TextBlock Grid.Row="2" Text="添加仓库" FontSize="20" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasRepository}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </Grid>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"><DockPanel Margin="14,0"><TextBlock DockPanel.Dock="Right" Text="{Binding SummaryCostLabel}" ToolTip="{Binding SummaryCostDetail}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0" /><ProgressBar DockPanel.Dock="Left" Width="70" Height="3" IsIndeterminate="True" Margin="0,0,10,0" Visibility="{Binding IsBusyProgressVisible, Converter={StaticResource BoolVisibility}}" /><TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Foreground="{DynamicResource MutedBrush}" /></DockPanel></Border>
    </Grid>
</Window>
